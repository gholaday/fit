{
  "expo": {
    "name": "Fit",
    "slug": "fit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fit",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F7F8",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7F7F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gholaday.fit",
      "versionCode": 1,
      "permissions": [
        "android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-release-signing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F7F8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#111214"
          }
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Inter",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Inter_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Inter_500Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Inter_600SemiBold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Inter_700Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Inter_400Regular.ttf",
              "./assets/fonts/Inter_500Medium.ttf",
              "./assets/fonts/Inter_600SemiBold.ttf",
              "./assets/fonts/Inter_700Bold.ttf"
            ]
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"],
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class * extends expo.modules.interfaces.taskManager.TaskConsumer { *; }"
          }
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
